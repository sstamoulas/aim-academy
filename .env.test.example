# Copy this file to .env.test and fill in real test account credentials.
# These accounts must already exist in your Firebase project (dev environment).
# NEVER use production credentials here.

# Admin test account (role = 'admin' custom claim)
TEST_ADMIN_EMAIL=admin@test.aimacademy.dev
TEST_ADMIN_PASSWORD=

# Teacher test account (role = 'teacher' custom claim)
TEST_TEACHER_EMAIL=teacher@test.aimacademy.dev
TEST_TEACHER_PASSWORD=

# Parent test account (role = 'parent' custom claim, registration approved)
TEST_PARENT_EMAIL=parent@test.aimacademy.dev
TEST_PARENT_PASSWORD=

# Optional: override base URL (defaults to http://localhost:5174)
# BASE_URL=http://localhost:5174

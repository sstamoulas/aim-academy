rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event flyer images and media galleries — authenticated users can upload, anyone can read
    match /events/{eventSlug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Program classroom media galleries — authenticated admins can upload, anyone can read
    match /programs/{programId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

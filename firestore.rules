rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin()   { return request.auth != null && request.auth.token.role == 'admin'; }
    function isTeacher() { return request.auth != null && request.auth.token.role == 'teacher'; }
    function isParent()  { return request.auth != null && request.auth.token.role == 'parent'; }
    function isStaff()   { return isAdmin() || isTeacher(); }

    // Events — public read for published events; admin-only write
    match /events/{eventId} {
      allow read: if resource.data.published == true;
      allow read, write: if isAdmin();
    }

    // Programs — public read for published; admin-only write
    match /programs/{docId} {
      allow read: if resource.data.published == true;
      allow read, write: if isAdmin();
    }

    // Achievements — public read; admin-only write
    match /achievements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews — public read for published; parents can submit; admin approves
    match /reviews/{docId} {
      allow read: if resource.data.published == true;
      allow read, write: if isAdmin();
      allow create: if isParent() && request.resource.data.submittedByUid == request.auth.uid;
      allow read: if isParent() && resource.data.submittedByUid == request.auth.uid;
    }

    // Site content (about, etc.) — public read; admin-only write
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact submissions — anyone can submit; admin-only read
    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Users — admin can read/write all; users can read their own record
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Classes — admin manages; teachers + parents can read
    match /classes/{classId} {
      allow read, write: if isAdmin();
      allow read: if isTeacher() || isParent();
    }

    // Students — admin manages; teachers can read/write; parents can read their own children
    match /students/{studentId} {
      allow read, write: if isAdmin();
      allow read, write: if isTeacher();
      allow read: if isParent() && resource.data.parentEmail == request.auth.token.email;
    }

    // Attendance sessions — staff can read/write; parents can read (app filters by child)
    match /attendance/{sessionId} {
      allow read, write: if isStaff();
      allow read: if isParent();
    }

    // Announcements — staff can create; published ones readable by parents
    match /announcements/{announcementId} {
      allow read, write: if isStaff();
      allow read: if isParent() && resource.data.published == true;
    }

    // Child registration requests — existing parents can submit; admin can create/approve/reject
    match /childRequests/{docId} {
      allow create: if isAdmin() || (isParent() && request.resource.data.parentUid == request.auth.uid);
      allow read: if isAdmin() || (isParent() && resource.data.parentUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Family registrations — any authenticated user can create/read their own;
    // admin can read/write all
    match /registrations/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin()   { return request.auth != null && request.auth.token.role == 'admin'; }
    function isTeacher() { return request.auth != null && request.auth.token.role == 'teacher'; }
    function isParent()  { return request.auth != null && request.auth.token.role == 'parent'; }
    function isStaff()   { return isAdmin() || isTeacher(); }

    // Events — public read for published events; admin-only write
    match /events/{eventId} {
      allow read: if resource.data.published == true;
      allow read, write: if isAdmin();
    }

    // Contact submissions — anyone can submit; admin-only read
    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Users — admin can read/write all; users can read their own record
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Classes — admin manages; teachers can read their own
    match /classes/{classId} {
      allow read, write: if isAdmin();
      allow read: if isTeacher();
    }

    // Students — admin manages; teachers can read/write for attendance purposes
    match /students/{studentId} {
      allow read, write: if isAdmin();
      allow read, write: if isTeacher();
    }

    // Attendance sessions — staff can read/write
    match /attendance/{sessionId} {
      allow read, write: if isStaff();
    }

    // Announcements — staff can create; published ones readable by parents
    match /announcements/{announcementId} {
      allow read, write: if isStaff();
      allow read: if isParent() && resource.data.published == true;
    }

    // (Future) Families / children
    match /families/{familyId} {
      allow read, write: if isAdmin();
      allow read: if isTeacher();
      allow read: if isParent() && request.auth.uid == resource.data.parentUid;
    }
  }
}

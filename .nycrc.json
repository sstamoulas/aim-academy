{
  "all": true,
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/main.tsx",
    "src/vite-env.d.ts",
    "**/*.d.ts",
    "node_modules/**"
  ],
  "reporter": ["text", "text-summary", "html", "lcov"],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80
}
